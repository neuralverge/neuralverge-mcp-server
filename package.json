{
  "name": "neuralverge-mcp-server",
  "version": "1.0.2",
  "mcpName": "ai.neuralverge/neuralverge",
  "description": "NeuralVerge MCP server: the data layer for agentic AI. Search, AI Extract and 300+ data sources (marketplaces, corporate registries, company intelligence, enrichment, social) as tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "neuralverge-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "generate": "node scripts/generate-endpoints.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "neuralverge",
    "ai-research",
    "ai-extract",
    "ai-agents",
    "linkedin",
    "data-enrichment"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "homepage": "https://neuralverge.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuralverge/neuralverge-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/neuralverge/neuralverge-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
